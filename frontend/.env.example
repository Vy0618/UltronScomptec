# Endereço público do backend, incluindo /api.
# Web: /api usa a mesma origem; no desenvolvimento, o Vite encaminha à porta 8000.
# API em outro servidor: https://api.seu-dominio.com/api
# Electron: informe o endereço alcançável do servidor (padrão local na porta 8000).
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
