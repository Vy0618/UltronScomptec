{
  "name": "scomptec-cnc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader native",
    "lint": "oxlint",
    "test": "node --test --test-isolation=none src/services/*.test.js src/pages/admin/adminModel.test.js",
    "preview": "vite preview",

    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },

  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },

  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },

  "build": {
    "appId": "com.scomptec.cnc",
    "productName": "SCOMPTEC CNC",

    "directories": {
      "output": "release"
    },

    "electronDownload": {
      "cache": ".cache/electron"
    },

    "npmRebuild": false,

    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],

    "win": {
      "target": "nsis"
    }
  }
}
