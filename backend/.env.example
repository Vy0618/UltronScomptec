# CONFIGURAÇÃO DO BACKEND SCOMPTEC
# Edite este arquivo e reinicie o backend para aplicar as mudanças.
# Variáveis definidas na hospedagem têm prioridade sobre este arquivo.
# Não publique o .env com senhas. Use .env.example como modelo.

# ======================================================================
# BANCO DE DADOS — MYSQL
# ======================================================================
# Preencha DATABASE_URL com os dados fornecidos pela hospedagem.
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?charset=utf8mb4
# Exemplo hospedado (substitua os dados; não use este exemplo literalmente):
# DATABASE_URL="mysql+pymysql://meu_usuario:minha_senha@db.seu-dominio.com:3306/cnc_monitor?charset=utf8mb4"
# HOST: endereço do servidor do banco, sem https://. PORTA: normalmente 3306.
# NOME_DO_BANCO: nome exato criado no painel da hospedagem.
# Caracteres especiais no usuário/senha precisam de codificação na URL:
# @ vira %40, # vira %23, / vira %2F, : vira %3A e % vira %25.
# Se o provedor exigir TLS/SSL, use os parâmetros e certificado indicados por ele.
# Libere o IP do backend no painel do banco, caso o provedor exija.
# Mantenha as credenciais apenas no backend; nunca em variáveis VITE_*.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/cnc_monitor?charset=utf8mb4
SQL_ECHO=false

# ======================================================================
# ACESSO DO FRONTEND
# ======================================================================
# URLs do frontend, separadas por vírgula, sem barra final e sem /api.
# Exemplo: CORS_ORIGINS=https://seu-site.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ======================================================================
# AUTENTICAÇÃO
# ======================================================================
# AUTH_SECRET: chave aleatória privada da instalação.
# AUTH_TOKEN_TTL_MINUTES: duração do login em minutos (480 = 8 horas).
AUTH_SECRET=troque-esta-chave-em-producao
AUTH_TOKEN_TTL_MINUTES=480

# ======================================================================
# CONTA ADMINISTRATIVA
# ======================================================================
# Conta sincronizada ao iniciar o backend. Preencha e-mail e senha juntos.
# Use uma senha de 8 a 128 caracteres.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ======================================================================
# INTEGRAÇÃO COM O DISPOSITIVO
# ======================================================================
# Tempo sem comunicação para considerar o dispositivo offline, em segundos.
# DEVICE_API_KEY: chave compartilhada com o Opta pelo header X-Device-Key.
# Vazia permite integração inicial em rede local isolada.
DEVICE_OFFLINE_TIMEOUT_SECONDS=90
DEVICE_API_KEY=
